<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gt_wizard_carga_xml_form" model="ir.ui.view">
        <field name="name">gt.wizard.carga.xml.form</field>
        <field name="model">gt.wizard.carga.xml</field>
        <field name="arch" type="xml">
            <form string="Cargar XML del SAT Guatemala">
                <sheet>
                    <group invisible="estado_carga == 'procesado'">
                        <group string="Archivo a Cargar">
                            <field name="modo_carga" widget="radio"/>
                            <field name="archivo" widget="binary"
                                   filename="nombre_archivo"/>
                            <field name="nombre_archivo" invisible="1"/>
                        </group>
                        <group string="Póliza Destino">
                            <field name="poliza_id" readonly="1"/>
                        </group>
                    </group>

                    <!-- Resultado de la carga -->
                    <group invisible="estado_carga != 'procesado'">
                        <group string="Resumen">
                            <field name="total_cargados" readonly="1"/>
                            <field name="total_duplicados" readonly="1"/>
                            <field name="total_errores" readonly="1"/>
                        </group>
                    </group>

                    <field name="resultado_ids"
                           invisible="estado_carga != 'procesado'">
                        <list decoration-success="estado == 'ok'"
                              decoration-warning="estado == 'duplicado'"
                              decoration-danger="estado == 'error'">
                            <field name="nombre_archivo"/>
                            <field name="uuid"/>
                            <field name="estado" widget="badge"
                                   decoration-success="estado == 'ok'"
                                   decoration-warning="estado == 'duplicado'"
                                   decoration-danger="estado == 'error'"/>
                            <field name="mensaje"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_procesar"
                            string="Cargar al SAT"
                            type="object"
                            class="btn-primary"
                            invisible="estado_carga == 'procesado'"/>
                    <button name="action_cerrar"
                            string="Cerrar"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
